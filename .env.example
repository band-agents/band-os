# Set these in Vercel (Project, Settings, Environment Variables). Never commit real values.
STAFF_CODE=choose-a-code-your-team-can-remember-min-6-chars
SESSION_SECRET=a-long-random-string-at-least-24-chars
# Storage: add Upstash Redis from the Vercel Marketplace. It sets these for you:
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# Email (optional): the studio Gmail and a Google app password (myaccount.google.com/apppasswords), not the real password.
# GMAIL_USER=band.digi.tech@gmail.com
# GMAIL_APP_PASSWORD=

